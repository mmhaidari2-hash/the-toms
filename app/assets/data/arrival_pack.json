  "formsLab": true,
  "phrases": [
    {
      "id": "p999",
      "en": "Emergency — call 999 for ambulance, police or fire.",
      "fa": "اورژانس — برای آمبولانس، پلیس یا آتش‌نشانی با ۹۹۹ تماس بگیر.",
      "sp": "narrator"
    },
    {
      "id": "p111",
      "en": "For urgent medical help that is not a 999 emergency, call NHS 111.",
      "fa": "برای کمک پزشکی فوری که اورژانس ۹۹۹ نیست، با NHS 111 تماس بگیر.",
      "sp": "narrator"
    },
    {
      "id": "pgp",
      "en": "GP registration in England is free. You can register even without a fixed address.",
      "fa": "ثبت‌نام نزد پزشک عمومی در انگلستان رایگان است. حتی بدون آدرس ثابت هم می‌توانی ثبت‌نام کنی.",
      "sp": "narrator"
    },
    {
      "id": "pcouncil",
      "en": "Council tax helps pay for local services. Read every letter carefully before you reply.",
      "fa": "مالیات شورای شهر برای خدمات محلی است. قبل از جواب، هر نامه را با دقت بخوان.",
      "sp": "narrator"
    },
    {
      "id": "pplease",
      "en": "Please, thank you, and sorry open every door in Britain.",
      "fa": "لطفاً، ممنون و متأسفم در بریتانیا هر دری را باز می‌کند.",
      "sp": "narrator"
    },
    {
      "id": "pbus",
      "en": "A single to the high street, please.",
      "fa": "یک بلیط تک‌سفر به خیابان اصلی، لطفاً.",
      "sp": "me"
    },
    {
      "id": "phelp",
      "en": "Excuse me — could you help me, please?",
      "fa": "ببخشید — می‌تونید کمکم کنید، لطفاً؟",
      "sp": "me"
    }
  ],
